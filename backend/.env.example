SECRET_KEY=generate-a-unique-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
BACKEND_SERVICE_TOKEN=replace-with-the-same-random-token-in-both-services
DEMO_MODE=False

# Database options for local development (SQLite is the default).
DB_ENGINE=sqlite
DB_NAME=scheduler
DB_USER=scheduler
DB_PASSWORD=change-this-local-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Optional Groq assistant; the core scheduler and rules fallback work without it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
